# ============================================================
# QQAgent — 一个项目，一个仓库
# 只入库我们写的源码。第三方源码、模型权重、虚拟环境、
# 运行时产物全部排除。
# ============================================================

# ---------- 运行时目录（代码已收拢到 components/，这里只是部署目标）----------
cosyvoice2/

# ---------- 模型权重 ----------
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.gguf

# ---------- 虚拟环境 / Python ----------
venv/
venv310/
.venv/
__pycache__/
**/__pycache__/
*.pyc

# ---------- 下载物与压缩包 ----------
wheels/
*.zip
*.whl
*.tar.gz

# ---------- 音频 / 视频中间产物 ----------
*.mp3
*.flac
*.m4a
*.mp4

# ---------- 运行时产物 ----------
out/
output/
temp/
tmp/
logs/
.gradio/
*_tmp.wav

# ---------- 备份与临时文件 ----------
*.bak
*.bak_*
*.orig
*.rej

# ---------- 系统垃圾 ----------
Thumbs.db
.DS_Store
desktop.ini

# ---------- 工具工作区（不是项目代码）----------
.workbuddy/

# ---------- 凭据（绝不入库）----------
.ghconfig/
