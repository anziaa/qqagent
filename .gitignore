# ============================================================
# QQAgent — 一个项目，一个仓库
# 入库范围：自己写的组件 + 改过源码的上游插件（★见 README）。
# 没改过的第三方插件不入库，按 README 从插件市场安装原版。
# 模型权重、虚拟环境、运行时产物、字体文件全部排除。
# ============================================================

# ---------- 运行时目录（代码已收拢到 components/，这里只是部署目标）----------
cosyvoice2/

# ---------- 随仓库摆放但不入库的运行时组件 ----------
# runtime/ 下是 NapCat（QQ 协议端）和 AstrBot 本体，几百 MB 的第三方产物，
# 跟着项目放是为了"一个目录跑起来"，但绝不进版本库。
# 拉新副本后按 README 的「运行时组件」一节自己放回去。
runtime/

# ---------- 模型权重 ----------
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.gguf

# ---------- 虚拟环境 / Python ----------
venv/
venv310/
.venv/
__pycache__/
**/__pycache__/
*.pyc

# ---------- 下载物与压缩包 ----------
wheels/
*.zip
*.whl
*.tar.gz

# ---------- 音频 / 视频中间产物 ----------
*.mp3
*.flac
*.m4a
*.mp4

# ---------- 运行时产物 ----------
out/
output/
temp/
tmp/
logs/
.gradio/
*_tmp.wav

# ---------- 备份与临时文件 ----------
*.bak
*.bak_*
*.orig
*.rej

# ---------- 插件自带字体（体积大且有版权，见 README 手动补齐）----------
components/*/fonts/*.ttf
components/*/core/renderer/resources/*.ttf

# ---------- 插件运行时数据（配置、缓存）----------
components/*/data/

# ---------- 误生成的 AstrBot 数据目录 ----------
# scripts/tools 下某些脚本 import 插件模块时会连带初始化 AstrBot，
# 它按「当前工作目录」建 data/。真的数据在 runtime/astrbot/data/。
/data/
/components/data/

# ---------- 系统垃圾 ----------
Thumbs.db
.DS_Store
desktop.ini

# ---------- 工具工作区（不是项目代码）----------
.workbuddy/

# ---------- 凭据（绝不入库）----------
.ghconfig/

# ---------- 实际配置：含 QQ 号与本机路径，只提交 *.example.json ----------
config/*.json
!config/*.example.json

# ---------- 实际人格：含私人对话，只提交示例 ----------
config/personas/*.md
!config/personas/example.md

# ---------- 音色参考音频：属于个人生物特征 ----------
config/ref/*.wav

# ---------- 本机启动路径：模板入库，实际值不入库 ----------
scripts/local.env

# ---------- 扫码登录的临时产物 ----------
# 二维码是一次性凭证（虽然会过期），状态日志里带本机绝对路径，两个都不该进库
scripts/tools/qq_login_qr.png
scripts/tools/login_status.log

# ---------- 沙箱 ACL 诊断报告 ----------
# 记录里是本机每个文件/目录的完整 ACL 和账户名，属于机器指纹
.acl-reports/

# ---------- 机器人记忆库（Obsidian 库）----------
# 物理上放在仓库里方便一起备份，但内容含 QQ 号、私人对话、她记下的事，
# 公开仓库绝不能收。要版本管理就单独建一个私有仓库指向这个目录。
memory/
