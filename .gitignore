# ============================================================
# QQAgent — 一个项目，一个仓库
# 入库范围：自己写的组件 + 改过源码的上游插件（★见 README）。
# 没改过的第三方插件不入库，按 README 从插件市场安装原版。
# 模型权重、虚拟环境、运行时产物、字体文件全部排除。
# ============================================================

# ---------- 运行时目录（代码已收拢到 components/，这里只是部署目标）----------
cosyvoice2/

# ---------- 随仓库摆放但不入库的运行时组件 ----------
# runtime/ 下是 NapCat（QQ 协议端）和 AstrBot 本体，几百 MB 的第三方产物，
# 跟着项目放是为了"一个目录跑起来"，但绝不进版本库。
# 拉新副本后按 README 的「运行时组件」一节自己放回去。
runtime/

# ---------- 模型权重 ----------
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.gguf

# ---------- 虚拟环境 / Python ----------
venv/
venv310/
.venv/
__pycache__/
**/__pycache__/
*.pyc

# ---------- 下载物与压缩包 ----------
wheels/
*.zip
*.whl
*.tar.gz

# ---------- 音频 / 视频中间产物 ----------
*.mp3
*.flac
*.m4a
*.mp4

# ---------- 运行时产物 ----------
out/
output/
temp/
tmp/
logs/
.gradio/
*_tmp.wav

# ---------- 备份与临时文件 ----------
*.bak
*.bak_*
*.orig
*.rej

# ---------- 插件自带字体（体积大且有版权，见 README 手动补齐）----------
components/*/fonts/*.ttf
components/*/core/renderer/resources/*.ttf

# ---------- 插件运行时数据（配置、缓存）----------
components/*/data/

# ---------- 系统垃圾 ----------
Thumbs.db
.DS_Store
desktop.ini

# ---------- 工具工作区（不是项目代码）----------
.workbuddy/

# ---------- 凭据（绝不入库）----------
.ghconfig/

# ---------- 实际配置：含 QQ 号与本机路径，只提交 *.example.json ----------
config/*.json
!config/*.example.json

# ---------- 实际人格：含私人对话，只提交示例 ----------
config/personas/*.md
!config/personas/example.md

# ---------- 音色参考音频：属于个人生物特征 ----------
config/ref/*.wav
